# Generated by Cargo / Rust build artifacts
/target/
**/target/

# Backup files generated by rustfmt
**/*.rs.bk

# Cargo.lock is ignored for libraries but kept for binaries; for a workspace
# of libraries we ignore it so dependency resolution stays flexible.
/Cargo.lock

# Test / benchmark artifacts
*.bench
benches/**/*.out

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.*
*.pem
*.key

# Generated docs
/docs/api/
/site/

# wasm-bindgen glue output (regenerate with scripts/build-web.ps1|.sh)
/web/pkg/


# Coverage
/coverage/
*.lcov
